generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Event {
  id          String       @id @default(uuid())
  date        String
  name        String
  adminName   String
  attendances Attendance[]
  createdAt   DateTime     @default(now())
}

model Attendance {
  id           String   @id @default(uuid())
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      String
  attendeeName String
  createdAt    DateTime @default(now())

  @@unique([eventId, attendeeName])
}

model Rule {
  id        String   @id @default(uuid())
  content   String
  updatedAt DateTime @updatedAt
}

model Absence {
  id        String   @id @default(uuid())
  name      String   @unique
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id    String @id @default("admin_list")
  value String
}

model Award {
  id         String   @id @default(uuid())
  date       String
  eventName  String
  winnerName String
  awardName  String
  createdAt  DateTime @default(now())
}
